rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Message Rules ---
    match /messages/{messageId} {
      function isValidMessage(data) {
        return data.userId == request.auth.uid
          && data.text is string && data.text.size() <= 5000
          && data.sender in ['user', 'ai']
          && data.timestamp == request.time
          && data.keys().hasAll(['userId', 'text', 'sender', 'timestamp']);
      }

      allow list: if isSignedIn(); // Soldiers can read the shared field report
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidMessage(incoming());
      allow update, delete: if false;
    }

    // --- Stats Rules ---
    match /stats/{userId} {
      function isValidStats(data) {
        return data.userId == request.auth.uid
          && data.totalCalories is number
          && data.currentAlcohol is number
          && (data.userName == null || (data.userName is string && data.userName.size() <= 100))
          && (data.userPhoto == null || (data.userPhoto is string && data.userPhoto.size() <= 1000))
          && data.keys().hasAll(['userId', 'totalCalories', 'currentAlcohol']);
      }

      allow list: if isSignedIn(); // Allow leaderboard lookup
      allow get: if isSignedIn(); // Allow seeing other soldiers' basic stats
      allow create, update: if isOwner(userId) && isValidStats(incoming());
    }

    // --- User Profile Rules ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == request.auth.uid
          && data.email == request.auth.token.email
          && data.displayName is string && data.displayName.size() <= 100
          && data.photoURL is string && data.photoURL.size() <= 1000
          && (data.height == null || data.height is number)
          && (data.weight == null || data.weight is number)
          && (data.age == null || data.age is number)
          && (data.gender == null || data.gender in ['male', 'female', 'other'])
          && data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL']);
      }

      allow get: if isSignedIn(); // Soldiers can see each others' profiles
      allow create, update: if isOwner(userId) && isValidUser(incoming());
    }
  }
}
