rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Rules ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == request.auth.uid 
          && (data.get('height', 0) is number || data.height == null)
          && (data.get('weight', 0) is number || data.weight == null)
          && (data.get('age', 0) is number || data.age == null)
          && (data.get('gender', '') in ['male', 'female', 'other', ''] || data.gender == null)
          && data.keys().hasAll(['uid'])
          && data.keys().size() <= 10;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming()) 
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time;
    }

    // --- Report Rules ---
    match /reports/{reportId} {
      function isValidReport(data) {
        return data.userId == request.auth.uid
          && data.shvejk_comment is string && data.shvejk_comment.size() <= 2000
          && (data.get('alcohol_est', 0) is number)
          && (data.get('calories_est', 0) is number)
          && data.timestamp == request.time
          && data.keys().hasAll(['userId', 'timestamp', 'shvejk_comment']);
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidReport(incoming());
      // Reports are typically immutable in this app's logic
      allow update, delete: if false;
    }
  }
}
