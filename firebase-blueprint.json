{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "A field report or response in the military diary.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the soldier." },
        "text": { "type": "string", "description": "The content of the report." },
        "sender": { "type": "string", "enum": ["user", "ai"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "imageUrl": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "shvejk_comment": { "type": "string" },
            "military_order": { "type": "string" },
            "estimated_calories": { "type": "number" },
            "estimated_alcohol_promille": { "type": "number" }
          }
        }
      },
      "required": ["userId", "text", "sender", "timestamp"]
    },
    "UserStats": {
      "title": "UserStats",
      "description": "Aggregated military performance stats.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "totalCalories": { "type": "number" },
        "currentAlcohol": { "type": "number" },
        "lastUpdate": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "totalCalories", "currentAlcohol"]
    },
    "User": {
      "title": "User",
      "description": "Soldier personal profile and contact info.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "height": { "type": "number" },
        "weight": { "type": "number" },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] }
      },
      "required": ["uid", "displayName", "email", "photoURL", "updatedAt"]
    }
  },
  "firestore": {
    "messages": {
      "schema": "Message",
      "description": "Collection of all field reports and Shvejk's wisdom."
    },
    "stats": {
      "schema": "UserStats",
      "description": "Soldier performance tracking."
    },
    "users": {
      "schema": "User",
      "description": "Personal profiles of all mašírující soldiers."
    }
  }
}
